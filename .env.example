# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places (server-side only). Enable "Places API (New)" + billing.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Maps JS (browser). Enable "Maps JavaScript API". Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-browser-maps-api-key
